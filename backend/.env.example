# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hospitality?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hospitality_dev

# JWT Authentication
JWT_SECRET=super_secret_hospitality_jwt_signing_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Client Origin
CLIENT_ORIGIN=http://localhost:3000

# File Upload Configuration (Local Storage Abstraction)
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX=100 # Maximum requests per window
AUTH_RATE_LIMIT_MAX=20 # Stricter limit for auth endpoints

